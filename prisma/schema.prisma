// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AccountSettings {
  shop           String   @id
  tokenEncrypted String
  inventoryLocationId String?
  defaultMargin  String   @default("0.00")
  minPrice       String   @default("0.00")
  maxPrice       String   @default("0.00")
  skipUnmapped   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model CategoryMapping {
  shop             String
  sourceStoreId    Int
  sourceCategoryId Int
  collectionId     String?
  profitMargin     String   @default("0")
  updatedAt        DateTime @updatedAt

  @@id([shop, sourceStoreId, sourceCategoryId])
}

model ImportJob {
  id               String        @id @default(cuid())
  shop             String
  activeShop       String?       @unique
  status           String        @default("preparing")
  workerToken      String?
  leaseExpiresAt   DateTime?
  fileName         String
  sourcePath       String?
  fileHash         String?
  ruleSnapshotJson String
  rowsRead         Int           @default(0)
  eligible         Int           @default(0)
  skipped          Int           @default(0)
  invalid          Int           @default(0)
  variantCount     Int           @default(0)
  warnings         Int           @default(0)
  errorsJson       String        @default("[]")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  lastCompletedRow Int           @default(0)
  productsSynced   Int           @default(0)
  inventoryCursor String?
  inventoryLocationId String?
  inventoryProductsProcessed Int @default(0)
  lastImageRow Int @default(0)
  imageProductsSynced Int @default(0)
  publicationId String?
  lastPublishedRow Int @default(0)
  productsPublished Int @default(0)

  @@index([shop, createdAt])
}
